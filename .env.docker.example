# Sao chép thành .env và chỉnh giá trị thật trước khi docker compose up.
# Trong mạng Docker, hostname là tên service: mongo, redis.

PORT=9001
NODE_ENV=production

DB_URI=mongodb://mongo:27017/vn-tours

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change-me-min-8-chars
JWT_REFRESH_SECRET=change-me-min-8-chars

# FE + CORS production (thêm domain thật, phân tách bằng dấu phẩy)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FE_BASE_URL=https://yourdomain.com

# Tuỳ chọn: Stripe, Cloudinary, Resend, OpenAI, ...
