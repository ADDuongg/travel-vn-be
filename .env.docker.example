# Sao chép thành .env và chỉnh giá trị thật trước khi docker compose up.
# Trong mạng Docker, hostname là tên service: mongo, redis.

PORT=9001
NODE_ENV=production

# Logging (JSON stdout / Loki): SERVICE_NAME mặc định tours-api; APP_VERSION = tag/deploy id
# SERVICE_NAME=tours-api
# APP_VERSION=1.0.0

DB_URI=mongodb://mongo:27017/vn-tours?replicaSet=rs0
MONGO_USER=change-me
MONGO_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch (optional; URL dùng hostname service khi API chạy trong Docker)
# ELASTICSEARCH_ENABLED=true
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_TOURS_INDEX=tours

JWT_SECRET=change-me-min-8-chars
JWT_REFRESH_SECRET=change-me-min-8-chars

# FE + CORS production (thêm domain thật, phân tách bằng dấu phẩy)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FE_BASE_URL=https://yourdomain.com

# Tuỳ chọn: Stripe, Cloudinary, Resend, OpenAI, ...

# --- Grafana / Prometheus (docker-compose.monitoring.*.yml) ---
# Trên VPS: đặt MONITORING_GRAFANA_ADMIN_PASSWORD mạnh; không commit .env thật.
MONITORING_GRAFANA_ADMIN_USER=admin
MONITORING_GRAFANA_ADMIN_PASSWORD=changeme-monitor-grafana

# Local: Prometheus + Grafana trên loopback
MONITORING_PROMETHEUS_PORT_LOCAL=9090
MONITORING_GRAFANA_PORT_LOCAL=3030
# Loki HTTP API (chỉ debug local; staging/prod để nội bộ Docker network).
MONITORING_LOKI_PORT_LOCAL=3100

# Staging / production (cùng VPS: đổi cổng để tránh trùng)
MONITORING_GRAFANA_PORT_STAGING=3031
MONITORING_GRAFANA_PORT_PRODUCTION=3032
